+}
+
+.glow-yellow-sm {
+  box-shadow: 0 0 20px rgba(255, 208, 0, 0.2);
+}
+
+/* Card hover */
+.card-hover {
+  transition: transform 0.3s ease, box-shadow 0.3s ease, border-color 0.3s ease;
+}
+
+.card-hover:hover {
